<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NativeCoreProfile Condition="'$(Configuration)' == 'Release'">release</NativeCoreProfile>
    <NativeCoreProfile Condition="'$(NativeCoreProfile)' == ''">debug</NativeCoreProfile>
    <NativeCoreTargetDir Condition="'$(NativeCoreTargetDir)' == ''">$(MSBuildThisFileDirectory)../../core/target</NativeCoreTargetDir>
    <NativeCoreLibrary>$(NativeCoreTargetDir)/$(NativeCoreProfile)/tiez_native_core.dll</NativeCoreLibrary>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(NativeCoreLibrary)" Link="tiez_native_core.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireNativeCoreLibrary" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(NativeCoreLibrary)')" Text="Build the matching Rust core first. Native library missing: $(NativeCoreLibrary)" />
  </Target>
</Project>
