<UserControl
    x:Class="TieZ.Native.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TieZ.Native">
    <UserControl.Resources>
                    <DataTemplate x:Key="StandardHistoryTemplate" x:DataType="local:HistoryRow">
                        <StackPanel PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited" Unloaded="OnRowUnloaded" Spacing="4" Padding="8,8">
                            <TextBlock Text="{x:Bind Preview, Mode=OneWay}" TextWrapping="Wrap" MaxLines="2" FontSize="14"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Metadata, Mode=OneWay}" FontSize="12" MaxLines="1"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate x:Key="CompactHistoryTemplate" x:DataType="local:HistoryRow">
                        <StackPanel PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited" Unloaded="OnRowUnloaded" Spacing="2" Padding="8,4">
                            <TextBlock Text="{x:Bind Preview, Mode=OneWay}" TextWrapping="Wrap" MaxLines="1"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Metadata, Mode=OneWay}" FontSize="12" MaxLines="1"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
        <DataTemplate x:Key="CardHistoryTemplate" x:DataType="local:HistoryRow">
            <Border Height="168" Padding="12" Margin="2" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited" Unloaded="OnRowUnloaded">
                <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind TypeLabel, Mode=OneWay}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Tag="card-copy" Click="OnCardCopyClick" Loaded="OnCardCopyLoaded" Unloaded="OnCardCopyUnloaded" DataContextChanged="OnCardCopyContextChanged"
                                    MinWidth="28" MinHeight="28" Padding="4"><SymbolIcon Symbol="Copy"/></Button>
                            <Button Tag="card-copy-plain" Click="OnCardCopyClick" Loaded="OnCardCopyLoaded" Unloaded="OnCardCopyUnloaded" DataContextChanged="OnCardCopyContextChanged"
                                    MinWidth="28" MinHeight="28" Padding="4"><SymbolIcon Symbol="Document"/></Button>
                            <Button Tag="card-open" Click="OnCardOpenClick" Loaded="OnCardOpenLoaded" Unloaded="OnCardOpenUnloaded" DataContextChanged="OnCardOpenContextChanged"
                                    MinWidth="28" MinHeight="28" Padding="4"><SymbolIcon Symbol="OpenFile"/></Button>
                        </StackPanel>
                    </Grid>
                    <local:HistoryThumbnailView Grid.Row="1"/>
                    <TextBlock Grid.Row="2" Text="{x:Bind Metadata, Mode=OneWay}" FontSize="12" MaxLines="2" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CompactCardHistoryTemplate" x:DataType="local:HistoryRow">
            <Border Height="100" Padding="10" Margin="2" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited" Unloaded="OnRowUnloaded">
                <Grid RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <local:HistoryThumbnailView/>
                    <Grid Grid.Row="1" ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Metadata, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" MaxLines="2"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Tag="card-copy" Click="OnCardCopyClick" Loaded="OnCardCopyLoaded" Unloaded="OnCardCopyUnloaded" DataContextChanged="OnCardCopyContextChanged"
                                    MinWidth="28" MinHeight="28" Padding="4"><SymbolIcon Symbol="Copy"/></Button>
                            <Button Tag="card-copy-plain" Click="OnCardCopyClick" Loaded="OnCardCopyLoaded" Unloaded="OnCardCopyUnloaded" DataContextChanged="OnCardCopyContextChanged"
                                    MinWidth="28" MinHeight="28" Padding="4"><SymbolIcon Symbol="Document"/></Button>
                            <Button Tag="card-open" Click="OnCardOpenClick" Loaded="OnCardOpenLoaded" Unloaded="OnCardOpenUnloaded" DataContextChanged="OnCardOpenContextChanged"
                                    MinWidth="28" MinHeight="28" Padding="4"><SymbolIcon Symbol="OpenFile"/></Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="WorkspaceRoot" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" Background="Transparent"
                        OverflowButtonVisibility="Visible" IsDynamicOverflowEnabled="False">
                <AppBarButton x:Name="CaptureButton" Icon="Play"/>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="ReturnTargetButton" Icon="Back"/>
                    <AppBarButton x:Name="StartTargetButton" Icon="Find"/>
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="132"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchText" FontSize="14" MinHeight="36" VerticalContentAlignment="Center"/>
            <ComboBox x:Name="TypeFilter" Grid.Column="1" SelectedIndex="0" MinHeight="36" HorizontalAlignment="Stretch">
                <ComboBoxItem x:Name="TypeAllItem"/><ComboBoxItem x:Name="TypeTextItem"/>
                <ComboBoxItem x:Name="TypeCodeItem"/><ComboBoxItem x:Name="TypeLinkItem"/>
                <ComboBoxItem x:Name="TypeRichTextItem"/><ComboBoxItem x:Name="TypeImageItem"/>
                <ComboBoxItem x:Name="TypeFileItem"/><ComboBoxItem x:Name="TypeVideoItem"/>
            </ComboBox>
            <Button x:Name="FiltersButton" Grid.Column="2" MinWidth="40" MinHeight="36" Padding="10,6">
                <Grid><SymbolIcon Symbol="Filter"/>
                    <Ellipse x:Name="ActiveFilterDot" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-3,-3,0" Fill="{ThemeResource SystemControlHighlightAccentBrush}" Visibility="Collapsed"/>
                </Grid>
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="284" Spacing="12">
                            <TextBlock x:Name="FiltersTitle" FontSize="18" FontWeight="SemiBold"/>
                            <TextBox x:Name="TagFilter" MinWidth="0"/>
                            <CheckBox x:Name="PinnedOnly"/><CheckBox x:Name="TagOnly"/>
                            <ComboBox x:Name="OrderChoice" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem x:Name="SortPinnedItem"/><ComboBoxItem x:Name="SortTimeItem"/><ComboBoxItem x:Name="SortUsageItem"/>
                            </ComboBox>
                            <ComboBox x:Name="LayoutChoice" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem x:Name="LayoutListItem"/><ComboBoxItem x:Name="LayoutCardsItem"/>
                            </ComboBox>
                            <Button x:Name="ReloadLayoutButton" HorizontalAlignment="Right" Padding="8" MinWidth="40" MinHeight="32">
                                <SymbolIcon Symbol="Refresh"/>
                            </Button>
                            <TextBlock x:Name="TargetInfo" TextWrapping="Wrap" Style="{StaticResource NativeCaptionStyle}"/>
                            <TextBlock x:Name="DatabaseNote" TextWrapping="Wrap" Style="{StaticResource NativeCaptionStyle}"/>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <CommandBar x:Name="RecordCommands" Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    DefaultLabelPosition="Right" Background="Transparent" OverflowButtonVisibility="Auto" IsDynamicOverflowEnabled="True">
            <AppBarButton x:Name="AddButton" Icon="Add"/>
            <AppBarSeparator/>
            <AppBarButton x:Name="PasteButton" Icon="Paste"/>
            <AppBarButton x:Name="CopyButton" Icon="Copy"/>
            <AppBarButton x:Name="EditButton" Icon="Edit"/>
            <AppBarButton x:Name="OpenButton" Icon="OpenFile" DynamicOverflowOrder="2"/>
            <AppBarButton x:Name="PastePlainButton" Icon="Paste" DynamicOverflowOrder="1"/>
            <AppBarButton x:Name="PinButton" Icon="Pin" DynamicOverflowOrder="2"/>
            <AppBarButton x:Name="TagsButton" DynamicOverflowOrder="2">
                <AppBarButton.Icon><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8EC;"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="DeleteButton" Icon="Delete" DynamicOverflowOrder="2"/>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="CopyPlainButton" Icon="Document"/>
                <AppBarButton x:Name="PreviewButton" Icon="ZoomIn"/>
                <AppBarButton x:Name="RefreshButton" Icon="Refresh"/>
                <AppBarSeparator/>
                <AppBarButton x:Name="ClearButton" Icon="Clear"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <InfoBar x:Name="CaptureInfo" Grid.Row="3" IsOpen="False" IsClosable="True" Severity="Warning"/>
        <Grid x:Name="HistoryBody" Grid.Row="4" ColumnSpacing="0" RowSpacing="0">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="DetailRow" Height="0"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition x:Name="DetailColumn" Width="0"/></Grid.ColumnDefinitions>
            <Border x:Name="RecordsSurface" Style="{StaticResource NativeSurfaceStyle}" Padding="4">
                <Grid>
                    <ListView x:Name="HistoryList" SelectionMode="Extended" ItemTemplate="{StaticResource StandardHistoryTemplate}"
                              HorizontalContentAlignment="Stretch" IsItemClickEnabled="False">
                        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
                        <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4,0"/>
                            <Setter Property="Margin" Value="0,2"/><Setter Property="CornerRadius" Value="6"/>
                        </Style></ListView.ItemContainerStyle>
                    </ListView>
                    <GridView x:Name="HistoryCards" SelectionMode="Extended" ItemTemplate="{StaticResource CardHistoryTemplate}"
                              Visibility="Collapsed" HorizontalContentAlignment="Stretch" IsItemClickEnabled="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="240"/></ItemsPanelTemplate></GridView.ItemsPanel>
                        <GridView.ItemContainerStyle><Style TargetType="GridViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="2"/><Setter Property="MinWidth" Value="0"/>
                        </Style></GridView.ItemContainerStyle>
                    </GridView>
                    <StackPanel x:Name="EmptyHistory" MaxWidth="300" Margin="24" Spacing="10" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="16" Width="64" Height="64" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8C8;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Border>
                        <TextBlock x:Name="EmptyTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock x:Name="EmptyDescription" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="DetailPanel" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource NativeSurfaceStyle}" Padding="16">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DetailMetadata" Grid.Row="1" TextWrapping="Wrap" Style="{StaticResource NativeCaptionStyle}"/>
                    <Button x:Name="RevealButton" Grid.Row="2" HorizontalAlignment="Stretch" Visibility="Collapsed"/>
                    <StackPanel x:Name="DetailHint" Grid.Row="3" Spacing="8" Margin="0,8,0,0">
                        <TextBlock x:Name="DetailHintText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Grid x:Name="DetailBody" Grid.Row="4" Visibility="Collapsed">
                        <TextBox x:Name="DetailText" IsReadOnly="True" AcceptsReturn="True" BorderThickness="0" Background="Transparent"
                                 TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <local:ImagePreviewView x:Name="ImagePreview"/>
                        <local:DocumentPreviewView x:Name="DocumentPreview"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="5" Spacing="6">
            <InfoBar x:Name="Feedback" IsOpen="False" IsClosable="True"/>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ListStatus" VerticalAlignment="Center" Style="{StaticResource NativeCaptionStyle}"/>
                <ProgressRing x:Name="LoadingIndicator" Grid.Column="1" Width="16" Height="16" IsActive="False"/>
                <Button x:Name="MoreButton" Grid.Column="2"/>
            </Grid>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectionInfo" Style="{StaticResource NativeCaptionStyle}"/>
                <TextBlock x:Name="CaptureStatus" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource NativeCaptionStyle}"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
