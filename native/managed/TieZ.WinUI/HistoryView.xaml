<UserControl
    x:Class="TieZ.Native.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TieZ.Native">
    <UserControl.Resources>
                    <DataTemplate x:Key="StandardHistoryTemplate" x:DataType="local:HistoryRow">
                        <StackPanel PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited" Unloaded="OnRowUnloaded" Spacing="6" Padding="8,10">
                            <TextBlock Text="{x:Bind Preview}" TextWrapping="Wrap" MaxLines="3"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Metadata}" FontSize="12" MaxLines="1"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate x:Key="CompactHistoryTemplate" x:DataType="local:HistoryRow">
                        <StackPanel PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited" Unloaded="OnRowUnloaded" Spacing="2" Padding="8,4">
                            <TextBlock Text="{x:Bind Preview}" TextWrapping="Wrap" MaxLines="1"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Metadata}" FontSize="12" MaxLines="1"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
        <DataTemplate x:Key="CardHistoryTemplate" x:DataType="local:HistoryRow">
            <Border Height="168" Padding="12" Margin="2" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited" Unloaded="OnRowUnloaded">
                <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind Summary.ContentType}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Row="1" Text="{x:Bind Preview}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="2" Text="{x:Bind Metadata}" FontSize="12" MaxLines="2" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CompactCardHistoryTemplate" x:DataType="local:HistoryRow">
            <Border Height="100" Padding="10" Margin="2" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    PointerEntered="OnRowPointerEntered" PointerExited="OnRowPointerExited" Unloaded="OnRowUnloaded">
                <StackPanel Spacing="6">
                    <TextBlock Text="{x:Bind Preview}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind Metadata}" FontSize="12" TextWrapping="Wrap" MaxLines="2"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="剪贴板历史" FontSize="28" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" Spacing="6">
        <InfoBar x:Name="CaptureInfo" IsOpen="True" IsClosable="False" Severity="Informational"
                 Title="使用独立数据"
                 Message="正在准备原生采集，使用独立数据库。"/>
        <TextBlock x:Name="TargetInfo" Text="正在读取上次输入窗口" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBox x:Name="SearchText" PlaceholderText="搜索内容、来源、标签或识别结果"
                     AutomationProperties.Name="搜索剪贴板历史"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="TypeFilter" SelectedIndex="0" Width="140"
                          AutomationProperties.Name="内容类型">
                    <ComboBoxItem Content="全部类型"/><ComboBoxItem Content="文本"/>
                    <ComboBoxItem Content="代码"/><ComboBoxItem Content="链接"/>
                    <ComboBoxItem Content="富文本"/><ComboBoxItem Content="图片"/>
                    <ComboBoxItem Content="文件"/><ComboBoxItem Content="视频"/>
                </ComboBox>
                <TextBox x:Name="TagFilter" Width="140" PlaceholderText="精确标签"
                         AutomationProperties.Name="按精确标签筛选"/>
                <CheckBox x:Name="PinnedOnly" Content="仅置顶"/>
                <CheckBox x:Name="TagOnly" Content="仅搜索标签"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="OrderChoice" Header="记录排序" SelectedIndex="0" MinWidth="180" HorizontalAlignment="Left">
                <ComboBoxItem Content="默认（置顶优先）"/>
                <ComboBoxItem Content="时间（新到旧）"/>
                <ComboBoxItem Content="使用频率（高到低）"/>
            </ComboBox>
                <ComboBox x:Name="LayoutChoice" Header="记录布局" SelectedIndex="0" MinWidth="120" AutomationProperties.Name="记录布局">
                    <ComboBoxItem Content="列表"/><ComboBoxItem Content="卡片"/>
                </ComboBox>
                <Button x:Name="ReloadLayoutButton" Content="重读布局" VerticalAlignment="Bottom"/>
            </StackPanel>
        </StackPanel>
        <CommandBar Grid.Row="3" HorizontalContentAlignment="Left" DefaultLabelPosition="Right">
            <AppBarButton x:Name="CaptureButton" Label="开始采集" Icon="Play"/>
            <AppBarButton x:Name="ReturnTargetButton" Label="返回上次窗口" Icon="Back"/>
            <AppBarButton x:Name="StartTargetButton" Label="启用目标跟踪" Icon="Find"/>
            <AppBarSeparator/>
            <AppBarButton x:Name="AddButton" Label="新增" Icon="Add"/>
            <AppBarButton x:Name="PasteButton" Label="粘贴原始格式" Icon="Paste"/>
            <AppBarButton x:Name="PastePlainButton" Label="粘贴纯文本" Icon="Paste"/>
            <AppBarButton x:Name="PreviewButton" Label="紧凑预览" Icon="ZoomIn"/>
            <AppBarButton x:Name="CopyButton" Label="复制原始格式" Icon="Copy"/>
            <AppBarButton x:Name="CopyPlainButton" Label="复制为纯文本" Icon="Document"/>
            <AppBarButton x:Name="EditButton" Label="编辑" Icon="Edit"/>
            <AppBarButton x:Name="PinButton" Label="置顶" Icon="Pin"/>
            <AppBarButton x:Name="TagsButton" Label="标签">
                <AppBarButton.Icon><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8EC;"/></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="DeleteButton" Label="删除" Icon="Delete"/>
            <AppBarButton x:Name="ClearButton" Label="清空普通历史" Icon="Clear"/>
            <AppBarButton x:Name="RefreshButton" Label="刷新" Icon="Refresh"/>
        </CommandBar>
        <Grid Grid.Row="4" ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <ListView x:Name="HistoryList" SelectionMode="Extended" ItemTemplate="{StaticResource StandardHistoryTemplate}"
                      HorizontalContentAlignment="Stretch" IsItemClickEnabled="False"
                      AutomationProperties.Name="剪贴板历史记录">
                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>

            </ListView>
            <GridView x:Name="HistoryCards" SelectionMode="Extended" ItemTemplate="{StaticResource CardHistoryTemplate}"
                      Visibility="Collapsed" HorizontalContentAlignment="Stretch" IsItemClickEnabled="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="剪贴板历史卡片">
                <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="240"/></ItemsPanelTemplate></GridView.ItemsPanel>
                <GridView.ItemContainerStyle><Style TargetType="GridViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="2"/>
                    <Setter Property="MinWidth" Value="0"/>
                </Style></GridView.ItemContainerStyle>
            </GridView>
            <Border Grid.Column="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="DetailTitle" Text="选择一条记录" FontSize="20"/>
                    <TextBlock x:Name="DetailMetadata" Grid.Row="1" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="RevealButton" Grid.Row="2" Content="显示敏感内容" Visibility="Collapsed"/>
                    <Grid Grid.Row="3">
                        <TextBox x:Name="DetailText" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="所选记录的原始文本"/>
                        <local:ImagePreviewView x:Name="ImagePreview"/>
                        <local:DocumentPreviewView x:Name="DocumentPreview"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="5" Spacing="8">
            <InfoBar x:Name="Feedback" IsOpen="False" IsClosable="True"/>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ListStatus" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ProgressRing x:Name="LoadingIndicator" Grid.Column="1" Width="24" Height="24" IsActive="False"/>
                <Button x:Name="MoreButton" Grid.Column="2" Content="载入更多"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
