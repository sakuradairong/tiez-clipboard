<UserControl x:Class="TieZ.Native.TagPickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TieZ.Native" MinWidth="440">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="从全部标签中选择，或添加新名称。保存前不会更改记录。" TextWrapping="Wrap"/>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchText" PlaceholderText="搜索全部标签（不区分大小写）" AutomationProperties.Name="搜索可选标签"/>
            <Button x:Name="SearchButton" Grid.Column="1" Content="搜索"/>
        </Grid>
        <Grid Grid.Row="2" RowSpacing="6">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ListView x:Name="Choices" Height="160" SelectionMode="Multiple" HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="可选标签">
                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
                <ListView.ItemTemplate><DataTemplate x:DataType="local:PickerTagRow">
                    <Grid ColumnSpacing="8" Padding="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="14" Height="14" CornerRadius="3" Background="{x:Bind Swatch}" BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{x:Bind Details}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                    </Grid>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                <Button x:Name="MoreButton" Content="载入更多"/><TextBlock x:Name="PageStatus" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ListView x:Name="SelectedNames" Height="80" SelectionMode="Single" Header="已选标签（包含其他页）"
                      AutomationProperties.Name="已选标签">
                <ListView.ItemTemplate><DataTemplate x:DataType="local:PickedTagName"><TextBlock Text="{x:Bind Label}"/></DataTemplate></ListView.ItemTemplate>
            </ListView>
            <Button x:Name="RemoveButton" Grid.Column="1" Content="移除所选" VerticalAlignment="Bottom"/>
        </Grid>
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="NewName" PlaceholderText="新标签名称" AutomationProperties.Name="新标签名称" AcceptsReturn="True"/>
            <Button x:Name="AddButton" Grid.Column="1" Content="加入选择"/>
        </Grid>
        <TextBlock Grid.Row="5" Text="选中名为 sensitive、密码或 password 的标签会保护内容并清除 OCR；移除最后一个敏感标签会解除保护。"
                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
        <StackPanel Grid.Row="6" Spacing="6">
            <TextBlock x:Name="Feedback" TextWrapping="Wrap" Visibility="Collapsed"/>
            <Button x:Name="ReloadButton" Content="重新读取（放弃选择）"/>
        </StackPanel>
    </Grid>
</UserControl>
