<Window
    x:Class="TieZ.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TieZ.Native">
    <Grid x:Name="MainRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="Navigation" PaneDisplayMode="LeftCompact"
                        IsPaneOpen="True" OpenPaneLength="196"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="True">
            <NavigationView.PaneHeader>
                <TextBlock Text="TieZ" FontSize="28" FontWeight="SemiBold" Margin="16,12"/>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HistoryNav" Content="剪贴板" Tag="history">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Copy"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Spacing="8" Margin="12">
                    <Button x:Name="HideButton" Content="隐藏到托盘" IsEnabled="False"/>
                    <Button x:Name="QuitButton" Content="退出 TieZ"/>
                    <TextBlock Text="原生迁移版&#xA;使用独立数据" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </NavigationView.PaneFooter>
            <Grid Margin="16" RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <InfoBar x:Name="ShellError" IsOpen="False" Severity="Warning" Title="后台服务状态"/>
                <local:HistoryView x:Name="HistoryWorkspace" Grid.Row="1"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
