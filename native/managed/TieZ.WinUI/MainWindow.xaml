<Window
    x:Class="TieZ.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TieZ.Native">
    <Grid x:Name="MainRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="Navigation" PaneDisplayMode="LeftCompact"
                        IsPaneOpen="True" OpenPaneLength="196"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="True">
            <NavigationView.PaneHeader>
                <TextBlock Text="TieZ" FontSize="28" FontWeight="SemiBold" Margin="16,12"/>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HistoryNav" Content="剪贴板" Tag="history">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Copy"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <TextBlock Text="原生迁移版&#xA;使用独立数据" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16"/>
            </NavigationView.PaneFooter>
            <local:HistoryView x:Name="HistoryWorkspace" Margin="16"/>
        </NavigationView>
    </Grid>
</Window>
