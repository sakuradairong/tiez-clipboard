<Window
    x:Class="Tiez.WinUIProbe.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="TieZ" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="WinUI 3 main-window experiment · C++/WinRT + in-process Rust C ABI"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="RefreshButton_Click" Content="Refresh" />
                <Button Click="HideButton_Click" Content="Hide for 5 seconds" />
            </StackPanel>
        </Grid>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            PlaceholderText="Search the Rust snapshot by text, source app, or content type"
            TextChanged="SearchBox_TextChanged" />

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ItemsPanel" Spacing="12" />
            </ScrollViewer>
            <TextBlock
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="No clipboard entries match this query."
                Visibility="Collapsed" />
        </Grid>

        <Border
            Grid.Row="3"
            Padding="12"
            Background="{ThemeResource LayerFillColorAltBrush}"
            CornerRadius="8">
            <TextBlock x:Name="StatusText" Text="Loading Rust core…" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
