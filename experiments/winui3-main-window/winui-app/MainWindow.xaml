<Window
    x:Class="Tiez.WinUIProbe.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Padding="24" RowSpacing="12" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Text="TieZ" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="WinUI 3 main-window slice · C++/WinRT + switchable Rust adapter"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Adapter" VerticalAlignment="Center" />
                    <Border
                        Padding="8,3"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <TextBlock x:Name="AdapterText" Text="loading" />
                    </Border>
                    <TextBlock
                        x:Name="ReadOnlyText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <CheckBox
                    x:Name="PinWindowCheck"
                    Content="Pin window"
                    Checked="PinWindowCheck_Changed"
                    Unchecked="PinWindowCheck_Changed" />
                <Button Click="RefreshButton_Click" Content="Refresh" />
                <Button Click="HideButton_Click" Content="Hide for 5 seconds" />
            </StackPanel>
        </Grid>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            PlaceholderText="Search by text or source app · type chips filter content type"
            KeyDown="SearchBox_KeyDown"
            TextChanged="SearchBox_TextChanged" />

        <StackPanel
            x:Name="TypeFilterPanel"
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8">
            <ToggleButton x:Name="TypeAllButton" Content="All" IsChecked="True" Click="TypeAllButton_Click" />
            <ToggleButton x:Name="TypeTextButton" Content="text" Click="TypeChip_Click" Tag="text" />
            <ToggleButton x:Name="TypeImageButton" Content="image" Click="TypeChip_Click" Tag="image" />
            <ToggleButton x:Name="TypeUrlButton" Content="url" Click="TypeChip_Click" Tag="url" />
            <ToggleButton x:Name="TypeCodeButton" Content="code" Click="TypeChip_Click" Tag="code" />
            <ToggleButton x:Name="TypeFilesButton" Content="files" Click="TypeChip_Click" Tag="files" />
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <ScrollViewer x:Name="ItemsScroller" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ItemsPanel" Spacing="12" />
                </ScrollViewer>
                <TextBlock
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="No clipboard entries match this query."
                    Visibility="Collapsed" />
            </Grid>

            <Border
                Grid.Column="1"
                Padding="16"
                Background="{ThemeResource LayerFillColorAltBrush}"
                CornerRadius="8">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="DetailsTitleText"
                        Text="Clipboard details"
                        Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="DetailsMetadataText"
                        Grid.Row="1"
                        Text="Select Open details on an entry"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="DetailsContentText"
                            FontFamily="Consolas"
                            IsTextSelectionEnabled="True"
                            Text="Full clipboard content will appear here without WebView2."
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="4"
            Padding="12"
            Background="{ThemeResource LayerFillColorAltBrush}"
            CornerRadius="8">
            <TextBlock x:Name="StatusText" Text="Loading Rust core…" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
