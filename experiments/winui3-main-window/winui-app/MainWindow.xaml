<Window
    x:Class="Tiez.WinUIProbe.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Padding="24" RowSpacing="12" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Text="TieZ" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="WinUI 3 原生主窗口 · C++/WinRT + 可切换 Rust 适配器"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="适配器" VerticalAlignment="Center" />
                    <Border
                        Padding="8,3"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <TextBlock
                            x:Name="AdapterText"
                            AutomationProperties.Name="当前数据适配器"
                            Text="加载中" />
                    </Border>
                    <TextBlock
                        x:Name="ReadOnlyText"
                        AutomationProperties.Name="数据访问模式"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock
                    x:Name="HotkeyText"
                    AutomationProperties.Name="当前全局呼出快捷键"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="呼出快捷键：正在加载" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <CheckBox
                    x:Name="PinWindowCheck"
                    AutomationProperties.Name="固定 TieZ 主窗口"
                    AutomationProperties.HelpText="启用后，切换到其他应用时仍保持主窗口可见。"
                    Content="固定窗口"
                    Checked="PinWindowCheck_Changed"
                    Unchecked="PinWindowCheck_Changed" />
                <Button Click="SettingsButton_Click" Content="设置" AutomationProperties.Name="打开 TieZ 设置" />
                <Button
                    x:Name="ClearHistoryButton"
                    AutomationProperties.Name="清空未保护的剪贴板历史"
                    AutomationProperties.HelpText="清空前会再次确认；已固定或带标签的记录会保留。"
                    Click="ClearHistoryButton_Click"
                    Content="清空历史" />
                <Button
                    AutomationProperties.Name="刷新剪贴板历史"
                    AutomationProperties.HelpText="重新从 Rust 核心读取当前剪贴板记录。"
                    Click="RefreshButton_Click"
                    Content="刷新" />
                <Button
                    AutomationProperties.Name="暂时隐藏 TieZ 主窗口"
                    AutomationProperties.HelpText="隐藏主窗口 5 秒，然后自动重新显示。"
                    Click="HideButton_Click"
                    Content="隐藏 5 秒" />
            </StackPanel>
        </Grid>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            PlaceholderText="搜索文本或来源应用 · 使用类型按钮筛选内容"
            AutomationProperties.Name="搜索剪贴板历史"
            KeyDown="SearchBox_KeyDown"
            TextChanged="SearchBox_TextChanged" />

        <StackPanel
            x:Name="TypeFilterPanel"
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8">
            <ToggleButton x:Name="TypeAllButton" Content="全部" AutomationProperties.Name="显示全部类型" IsChecked="True" Click="TypeAllButton_Click" />
            <ToggleButton x:Name="TypeTextButton" Content="文本" AutomationProperties.Name="筛选文本" Click="TypeChip_Click" Tag="text" />
            <ToggleButton x:Name="TypeImageButton" Content="图片" AutomationProperties.Name="筛选图片" Click="TypeChip_Click" Tag="image" />
            <ToggleButton x:Name="TypeUrlButton" Content="链接" AutomationProperties.Name="筛选链接" Click="TypeChip_Click" Tag="url" />
            <ToggleButton x:Name="TypeCodeButton" Content="代码" AutomationProperties.Name="筛选代码" Click="TypeChip_Click" Tag="code" />
            <ToggleButton x:Name="TypeFilesButton" Content="文件" AutomationProperties.Name="筛选文件" Click="TypeChip_Click" Tag="file" />
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <ScrollViewer
                    x:Name="ItemsScroller"
                    AutomationProperties.Name="剪贴板历史记录列表"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ItemsPanel" Spacing="12" />
                </ScrollViewer>
                <TextBlock
                    x:Name="EmptyState"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="剪贴板历史为空"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="没有符合当前条件的剪贴板记录。"
                    Visibility="Collapsed" />
            </Grid>

            <Border
                Grid.Column="1"
                Padding="16"
                Background="{ThemeResource LayerFillColorAltBrush}"
                CornerRadius="8">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="DetailsTitleText"
                        AutomationProperties.Name="剪贴板详情标题"
                        Text="剪贴板详情"
                        Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Grid Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="DetailsMetadataText"
                            AutomationProperties.Name="所选记录的类型、来源和时间"
                            VerticalAlignment="Center"
                            Text="请选择记录并点击“查看详情”"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="OpenSelectedButton"
                            Grid.Column="1"
                            AutomationProperties.Name="用系统默认应用打开当前记录"
                            Click="OpenSelectedButton_Click"
                            Content="打开"
                            IsEnabled="False" />
                    </Grid>
                    <StackPanel Grid.Row="2" Spacing="6">
                        <TextBlock Text="标签（用逗号分隔）" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="TagsTextBox"
                                AutomationProperties.Name="当前记录标签"
                                IsEnabled="False"
                                KeyDown="TagsTextBox_KeyDown"
                                PlaceholderText="例如：工作、稍后处理" />
                            <Button
                                x:Name="SaveTagsButton"
                                Grid.Column="1"
                                AutomationProperties.Name="保存当前记录标签"
                                Click="SaveTagsButton_Click"
                                Content="保存标签"
                                IsEnabled="False" />
                        </Grid>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="sensitive、“密码”或 password 标签会立即保护本地内容并清除 OCR 明文索引。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer
                        Grid.Row="3"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <Image
                                x:Name="DetailsImage"
                                MaxHeight="240"
                                Stretch="Uniform"
                                Visibility="Collapsed"
                                AutomationProperties.Name="剪贴板图片预览" />
                            <Border
                                x:Name="ImageAnalysisPanel"
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="6"
                                Visibility="Collapsed">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="图片文字与二维码" />
                                        <ProgressRing
                                            x:Name="ImageAnalysisProgress"
                                            Grid.Column="1"
                                            Width="20"
                                            Height="20"
                                            IsActive="False"
                                            Visibility="Collapsed" />
                                        <Button
                                            x:Name="AnalyzeImageButton"
                                            Grid.Column="2"
                                            AutomationProperties.Name="识别当前图片中的文字和二维码"
                                            Click="AnalyzeImageButton_Click"
                                            Content="开始识别" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="ImageAnalysisStatusText"
                                        AutomationProperties.LiveSetting="Polite"
                                        AutomationProperties.Name="图片识别状态"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="尚未识别。结果只会在非敏感可写记录中建立搜索索引。"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="ImageAnalysisResultText"
                                        AutomationProperties.Name="图片识别结果"
                                        FontFamily="Consolas"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="CopyImageAnalysisButton"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="复制图片识别结果"
                                        Click="CopyImageAnalysisButton_Click"
                                        Content="复制识别结果"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                x:Name="DetailsContentText"
                                AutomationProperties.Name="所选剪贴板记录的完整内容"
                                FontFamily="Consolas"
                                IsTextSelectionEnabled="True"
                                Text="完整剪贴板内容将在此显示，无需 WebView2。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="4"
            Padding="12"
            Background="{ThemeResource LayerFillColorAltBrush}"
            CornerRadius="8">
            <TextBlock
                x:Name="StatusText"
                AutomationProperties.LiveSetting="Assertive"
                AutomationProperties.Name="TieZ 状态"
                Text="正在加载 Rust 核心…"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
