<Window
    x:Class="Tiez.WinUIProbe.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Padding="24" RowSpacing="12" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Text="TieZ" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="WinUI 3 原生主窗口 · C++/WinRT + 可切换 Rust 适配器"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="适配器" VerticalAlignment="Center" />
                    <Border
                        Padding="8,3"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="10">
                        <TextBlock x:Name="AdapterText" Text="加载中" />
                    </Border>
                    <TextBlock
                        x:Name="ReadOnlyText"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <CheckBox
                    x:Name="PinWindowCheck"
                    Content="固定窗口"
                    Checked="PinWindowCheck_Changed"
                    Unchecked="PinWindowCheck_Changed" />
                <Button Click="RefreshButton_Click" Content="刷新" />
                <Button Click="HideButton_Click" Content="隐藏 5 秒" />
            </StackPanel>
        </Grid>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            PlaceholderText="搜索文本或来源应用 · 使用类型按钮筛选内容"
            AutomationProperties.Name="搜索剪贴板历史"
            KeyDown="SearchBox_KeyDown"
            TextChanged="SearchBox_TextChanged" />

        <StackPanel
            x:Name="TypeFilterPanel"
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8">
            <ToggleButton x:Name="TypeAllButton" Content="全部" AutomationProperties.Name="显示全部类型" IsChecked="True" Click="TypeAllButton_Click" />
            <ToggleButton x:Name="TypeTextButton" Content="文本" AutomationProperties.Name="筛选文本" Click="TypeChip_Click" Tag="text" />
            <ToggleButton x:Name="TypeImageButton" Content="图片" AutomationProperties.Name="筛选图片" Click="TypeChip_Click" Tag="image" />
            <ToggleButton x:Name="TypeUrlButton" Content="链接" AutomationProperties.Name="筛选链接" Click="TypeChip_Click" Tag="url" />
            <ToggleButton x:Name="TypeCodeButton" Content="代码" AutomationProperties.Name="筛选代码" Click="TypeChip_Click" Tag="code" />
            <ToggleButton x:Name="TypeFilesButton" Content="文件" AutomationProperties.Name="筛选文件" Click="TypeChip_Click" Tag="files" />
        </StackPanel>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <ScrollViewer x:Name="ItemsScroller" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ItemsPanel" Spacing="12" />
                </ScrollViewer>
                <TextBlock
                    x:Name="EmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="没有符合当前条件的剪贴板记录。"
                    Visibility="Collapsed" />
            </Grid>

            <Border
                Grid.Column="1"
                Padding="16"
                Background="{ThemeResource LayerFillColorAltBrush}"
                CornerRadius="8">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="DetailsTitleText"
                        Text="剪贴板详情"
                        Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        x:Name="DetailsMetadataText"
                        Grid.Row="1"
                        Text="请选择记录并点击“查看详情”"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <Image
                                x:Name="DetailsImage"
                                MaxHeight="240"
                                Stretch="Uniform"
                                Visibility="Collapsed"
                                AutomationProperties.Name="剪贴板图片预览" />
                            <TextBlock
                                x:Name="DetailsContentText"
                                FontFamily="Consolas"
                                IsTextSelectionEnabled="True"
                                Text="完整剪贴板内容将在此显示，无需 WebView2。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="4"
            Padding="12"
            Background="{ThemeResource LayerFillColorAltBrush}"
            CornerRadius="8">
            <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Assertive" Text="正在加载 Rust 核心…" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
